# Copia este archivo como .env.local y pon los valores reales.
# En Vercel van en Settings → Environment Variables (Production y Preview).

# URL del Web App de Apps Script (termina en /exec). Solo la usa el
# servidor (app/api/gs): nunca llega al celular.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Contacto del administrador ("¿Olvidaste tu clave?" y Perfil).
# Se ven en pantalla, por eso son NEXT_PUBLIC_.
# El número en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_ADMIN_WHATSAPP=51987654321
NEXT_PUBLIC_ADMIN_EMAIL=admin@tu-empresa.com
